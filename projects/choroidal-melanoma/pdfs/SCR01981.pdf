<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 4.0-c316 44.253921, Sun Oct 01 2006 17:14:39">
<rdf:RDF xmlns:sb="http://www.elsevier.com/xml/common/dtd" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:pdfx="http://ns.adobe.com/pdfx/1.3/" xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/" xmlns:xap="http://ns.adobe.com/xap/1.0/" xmlns:xapRights="http://ns.adobe.com/xap/1.0/rights/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:prism="http://prismstandard.org/namespaces/basic/2.0/">
   <rdf:Description rdf:about="doi:10.1016/j.ophtha.2009.10.015">
      <dc:format>application/pdf</dc:format>
      <dc:title>Proliferative Radiation Retinopathy after Plaque Radiotherapy for Uveal Melanoma</dc:title>
